# MedSought AI Layer - Example environment variables

# Config
MEDSOUGHT_AI_CONFIG_PATH=ai_service/config/default.json
MEDSOUGHT_PROMPT_DIR=ai_service/prompts
MEDSOUGHT_LOG_LEVEL=info
MEDSOUGHT_RAG_ENABLED=true

# Providers (set to provider key names used by adapters)
MEDSOUGHT_LLM_PROVIDER=gemini
MEDSOUGHT_DRUG_INFO_PROVIDER=rxnorm
MEDSOUGHT_RETRIEVAL_PROVIDER=mongodb
MEDSOUGHT_TRANSLATION_PROVIDER=unconfigured

# Example provider-specific variables (do NOT commit real keys)
# Gemini LLM & Embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MEDSOUGHT_LLM_API_KEY=

# OpenAI (if used as alternative LLM)
OPENAI_API_KEY=
OPENAI_API_BASE=

# RxNorm/DailyMed drug-info API
DRUG_API_BASE_URL=https://rxnav.nlm.nih.gov/REST
DRUG_API_KEY=

# MongoDB Vector Search configuration
MONGODB_URI=
MONGODB_DATABASE=medsought
MONGODB_COLLECTION=knowledge_chunks
RAG_RELEVANCE_THRESHOLD=0.7

# NOTE: Never commit actual credentials. This file only demonstrates variable names.
