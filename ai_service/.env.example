# LLM provider configuration
MEDSOUGHT_LLM_PROVIDER=gemini
MEDSOUGHT_LLM_MODEL=gemini-2.5-flash
MEDSOUGHT_LLM_API_KEY=
MEDSOUGHT_LLM_BASE_URL=
GEMINI_API_KEY=

# Drug information provider configuration
MEDSOUGHT_DRUG_INFO_PROVIDER=rxnorm
MEDSOUGHT_DRUG_INFO_API_KEY=
MEDSOUGHT_DRUG_INFO_BASE_URL=https://rxnav.nlm.nih.gov/REST

# RAG / MongoDB Vector Search configuration
MEDSOUGHT_RAG_ENABLED=true
MEDSOUGHT_RETRIEVAL_PROVIDER=mongodb
MONGODB_URI=
MONGODB_DATABASE=medsought
MONGODB_COLLECTION=knowledge_chunks
RAG_RELEVANCE_THRESHOLD=0.7

# Translation provider configuration
MEDSOUGHT_TRANSLATION_PROVIDER=
MEDSOUGHT_TRANSLATION_API_KEY=

# Runtime configuration
MEDSOUGHT_AI_CONFIG_PATH=ai_service/config/default.json
MEDSOUGHT_PROMPT_DIR=ai_service/prompts
MEDSOUGHT_LOG_LEVEL=info
